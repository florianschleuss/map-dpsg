# Copy using scripts/init-env.py. Never commit .env or instance-specific assets.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_PROJECT_NAME=map-local
MAP_IMAGE=map-local:latest
SECRET_KEY=
POSTGRES_DB=map
POSTGRES_USER=map
POSTGRES_PASSWORD=
POSTGRES_HOST=db
DEBUG=0
HTTPS=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_URL=http://localhost:8000
MAP_PRODUCTION=0
# Set your existing proxy network and a unique alias for each installation.
PROXY_NETWORK=reverse-proxy
MAP_PROXY_ALIAS=map-production
MAP_TRUSTED_PROXY_HOSTS=caddy
MAP_TRUSTED_PROXY_NETWORKS=
# Operator identity. Plain text only; Django escapes it when rendering.
MAP_ORGANIZATION="Dein Pfadfinderstamm"
MAP_SITE_TITLE="Veranstaltungsanmeldungen"
MAP_MAIL_SENDER_NAME="Anmeldungsverwaltung"
MAP_RESPONSIBLE_NAME=
MAP_RESPONSIBLE_ADDRESS=
MAP_CONTACT_EMAIL=
MAP_IMPRINT_URL=
MAP_IMPRINT_TEXT=
MAP_HOSTING_DESCRIPTION=
MAP_MAIL_DESCRIPTION=
MAP_PRIVACY_LEGAL_TEXT=
MAP_PRIVACY_AUTHORITY=
MAP_PHOTO_DISPLAY_LABEL="Aushang von Bildern in den Veranstaltungsräumen"
MAP_LOGO_PATH=map/logo.svg
MAP_FAVICON_PATH=map/logo.svg
# SMTP/Exchange may instead be configured and tested through the admin menu.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=map@example.org
TOKEN_MAX_AGE=2592000
